QToolTip {
   background-color: #FFFFE1;
   color: palette(toolTipText);
   border: palette(text) solid 1px;
   border-radius: 2px;
   }

QTabBar {
  margin: 0px;
  padding-bottom: 0px;
  padding-top: 0px;}
  QTabBar::tab {
  	background: transparent;
	margin-top: 4px;
	margin-bottom: 4px;
	padding-top: 4px;
	padding-bottom: 4px;
	spacing: 0px;}
  QTabBar::scroller {
    min-width: 40px;}

QDockWidget {
	margin: 0px;
	padding-bottom: 0px;
	padding-top: 0px;}
	QDockWidget::title {
		margin: 0px;
		padding: 0px;
		text-align: center; }

QDockWidget::title QToolButton, QDockWidget::title QWidget#Selector > QToolButton {
	margin: 1px; }

CommandTabApplicationButton::menu-indicator {
    image: none;
	border: none;
}

QTabBar, QDockWidget QTabBar {
  qproperty-drawBase: 0;
}

CommandTabBar {
	padding-top: 0px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-left: 0px;
	margin-bottom: 0px;
	spacing: 0px;
}

CommandTabCategory {
	padding-top: 0px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 3px;
	margin-left: 3px;
	margin-bottom: 0px;
	spacing: 0px;
}

CommandTabCategoryScrollArea {
    background-color: transparent;
	padding-top: 0px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-left: 0px;
	margin-bottom: 0px;
	spacing: 0px;
}

CommandTabCategoryScrollAreaContents {
    background-color: transparent;
	padding-top: 0px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-left: 0px;
	margin-bottom: 0px;
	spacing: 0px;
}

CommandTabPanel {
	background-color: transparent;
	border: none;
	padding-top: 0px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-left: 0px;
	margin-bottom: 0px;
	spacing: 0px;
}

QFrame#CommandTabPanelBody {
	background-color: palette(window);
	border: 1px solid palette(mid);
	border-radius: 4px;
}

CommandTabPanelTitle {
	background-color: transparent;
	border: none;
	padding-top: 2px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-left: 0px;
	margin-bottom: 0px;
	spacing: 0px;
}

CommandTabPanelItemWidget {
    padding-top: 0px;
	padding-bottom: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-left: 0px;
	margin-bottom: 0px;
	spacing: 0px;
}

QTabBar {
    background-color: transparent;
}
