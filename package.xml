<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

  <name>FreeCAD CommandTab</name>

  <description>A native ribbon-style CommandTab interface for FreeCAD</description>

  <version>1.10.10.2</version>

  <date>2026-05-22</date>

  <maintainer>emilecachot</maintainer>

  <license file="LICENSE">LGPL-3.0-or-later</license>

  <pythonmin>3.8.0</pythonmin>

  <url type="website">https://github.com/emilecachot/FreeCAD-CommandTab</url>

  <url branch="main" type="repository">https://github.com/emilecachot/FreeCAD-CommandTab</url>

  <url type="readme">https://github.com/emilecachot/FreeCAD-CommandTab/blob/main/README.md</url>

  <content>
    <workbench>
      <freecadmin>0.21.0</freecadmin>
      <icon>Resources/icons/FreecadNew.svg</icon>
      <subdirectory>./</subdirectory>
      <!-- Optional install of 3rd-party SearchBar to streamline ability to Search and find commands -->
      <depend type="addon" optional="true">SearchBar</depend>
      <depend type="addon" optional="true">SaveAndRestore</depend>
      <depend type="python" optional="true">git</depend>
      <depend type="python" optional="true">gitpython</depend>
    </workbench>
  </content>

</package>
